# Mubit instance
MUBIT_ENDPOINT=http://127.0.0.1:3320
MUBIT_API_KEY=

# LLM (Gemini by default; set OPENAI_API_KEY instead for gpt-* models)
GEMINI_API_KEY=
DEMO_MODEL=gemini-3.7-flash

